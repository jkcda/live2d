# 线上 TTS 的配置。复制一份成 tools/tts-api.env 再改。
#
#   copy tools\tts-api.env.example tools\tts-api.env
#
# ★ tts-api.env 已经在 .gitignore 里，**不会入库** —— 里面是 API key。
#   这个 .example 是入库的，所以**别把真 key 写在这里**。
#
# 用法：
#   .\tools\start-api.cmd
#
# 它做的事：把下面这些变量设进环境，然后照常走 start-all.ps1。
# 引擎不是 cosyvoice 时会**跳过 CosyVoice 模型服务**（省 2.65GB 显存和十几秒加载）。

# ── 用哪家的 TTS ──
# openai = 任何 OpenAI 兼容的 /v1/audio/speech 端点（下面这组就是硅基流动）
# edge   = 微软 Edge 朗读，免费、不用 key（那就不用填下面的 key 了）
NEXUS_TTS_ENGINE=openai

# ── 接口地址 ──
# 填到 /v1 为止，程序自己拼 /audio/speech
NEXUS_TTS_API_URL=https://api.siliconflow.cn/v1

# ── API key ──
# ★ 只填在 tools/tts-api.env 里，不要填在这个 .example 里
NEXUS_TTS_API_KEY=

# ── 模型 ──
# 硅基流动上可用的：FunAudioLLM/CosyVoice2-0.5B 或 fnlp/MOSS-TTSD-v0.5
NEXUS_TTS_API_MODEL=FunAudioLLM/CosyVoice2-0.5B

# ── 音色 ──
# ★ 格式是「模型名:音色名」。只写 alex 会 400 Invalid voice。
NEXUS_TTS_API_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex

# ── 可选：语音识别 ──
# none = 不启用（默认）；sensevoice = 本地 FunASR。
# 硅基流动的 ASR（FunAudioLLM/SenseVoiceSmall）是免费的，但那是另一条路，暂未接。
NEXUS_ASR_ENGINE=sensevoice

# ── 可选：别的引擎参数 ──
# 想换回本地就把 NEXUS_TTS_ENGINE 改成 cosyvoice（那下面的 key 就都不需要了）
# NEXUS_TTS_VOICE=default
# NEXUS_PORT=8765

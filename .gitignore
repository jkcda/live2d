# ── Node ──
node_modules/
dist/
dist-electron/
release/
*.local

# ── Live2D 模型资源 ──
# 模型受 Live2D 官方许可约束，不入库；自行下载后放到 public/models/ 下
public/models/*
!public/models/.gitkeep

# Cubism Core 运行时同理，从官方 SDK 获取后放到 public/lib/ 下
public/lib/*
!public/lib/.gitkeep

# 立绘素材同理：自己的角色立绘不入库
public/portrait/*
!public/portrait/.gitkeep
# 但占位角色要入库 —— 它是照着写的参考例（`docs/portrait-assets.md` 里引用了它）
!public/portrait/_placeholder/
!public/portrait/_placeholder/**

# 角色清单要入库（它只是一份配置：角色 id / 名字 / 类型 / 素材目录）
# 素材本身仍然不入库，见各角色自己的目录
!public/characters/
!public/characters/**

# ── 本地素材仓 ──
# 官方 SDK 原始包、模型压缩包、Cubism 工程源文件（.can3/.cmo3）都放这里。
# 这些都是「来源可再取、体积大、许可受限」的东西，不进仓库；
# 也不能放 public/ 下 —— 那是会被 electron-builder 原样打进产物的目录。
vendor/

# ── Python 推理服务 ──
python/.venv/
python/venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# 模型权重（几个 G，自己下）
python/pretrained_models/

# 克隆音色的参考音频与转写（属于个人声音素材，不进仓库）
python/voices/*.wav
python/voices/*.mp3
python/voices/*.txt
!python/voices/README.md

# ── 运行时数据（会话转录 / 记忆 / 索引）──
data/
*.log
logs/

# ── 编辑器 / 系统 ──
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ── 会话上传的临时文件（用户拖进来的图等）──
.dsh-uploads/

# ����/���Բ���
*.wav
!python/voices/README.md

# Playwright MCP ����ҳ����д���⣨����ʱ�������⣩
.playwright-mcp/
agent/.playwright-mcp/

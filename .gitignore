# ── Node ──
node_modules/
dist/
dist-electron/
release/
*.local

# ── Live2D 模型资源 ──
# 模型受 Live2D 官方许可约束，不入库；自行下载后放到 public/models/ 下
public/models/*
!public/models/.gitkeep

# Cubism Core 运行时同理，从官方 SDK 获取后放到 public/lib/ 下
public/lib/*
!public/lib/.gitkeep

# ── Python 推理服务 ──
python/.venv/
python/venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 模型权重（几个 G，自己下）
python/pretrained_models/

# 克隆音色的参考音频与转写（属于个人声音素材，不进仓库）
python/voices/*.wav
python/voices/*.mp3
python/voices/*.txt
!python/voices/README.md

# ── 运行时数据（会话转录 / 记忆 / 索引）──
data/
*.log
logs/

# ── 编辑器 / 系统 ──
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

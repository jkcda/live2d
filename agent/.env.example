# 环境变量示例 —— 复制成 .env 再改（.env 已在 .gitignore 里）

# ── LLM（不填也能跑：应用会把设置面板里那套随请求发过来） ──
# 这里只是"服务自己单独跑/调试"时的默认值
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
AGENT_MODEL=deepseek-chat
AGENT_TEMPERATURE=0.85

# ── 服务 ──
AGENT_PORT=8766
# 记忆 / 摘要放哪（默认 ./data）
# AGENT_DATA_DIR=data

# ── 工具 ──
# 联网搜索：填了 Tavily 的 key 就用 Tavily，没填就退回 DuckDuckGo 抓 HTML
TAVILY_API_KEY=
# 设 0 直接关掉联网能力
# AGENT_WEB_SEARCH=0
AGENT_SEARCH_RESULTS=5

# ── 文件工作区 ──
# 她能读写的那个目录。**不填 = 文件能力整个关闭**（默认就是关的）。
#
# 为什么默认关：给她文件访问权 = 把「她能碰到你硬盘上什么」交出去了。
# 屏幕是"此刻这一眼"，文件是"你硬盘上躺着的一切" —— 后者更重。
# 所以默认什么都不给，要的时候你自己划一块地方出来。
#
#   AGENT_WORKSPACE=D://我的文档//给她看的东西
#
# 划进来之后的规则（实现在 src/services/files.ts）：
#   · 工作区外的路径一律拒绝（含 ../ 和绝对路径逃逸）
#   · .env / id_rsa / *.pem / .ssh / .git/config 这类**即使在工作区内也拒绝**
#   · 能新建文件，但**不能覆盖已存在的**（想改就换个名，或者你自己处理）
# AGENT_WORKSPACE=

# ── MCP ──
# 默认启用 Playwright（浏览器操作，无需 key）。要关掉：AGENT_MCP_DISABLE=playwright
# AGENT_MCP_DISABLE=
